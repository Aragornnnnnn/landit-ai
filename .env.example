APP_NAME=landit-ai
APP_ENV=local
LOG_LEVEL=INFO
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
MESSAGE_FEEDBACK_MODEL=
OPENROUTER_REVIEW_MODEL=
MESSAGE_FEEDBACK_REVIEW_ENABLED=true
FREE_TALK_CORRECTION_TIMEOUT_SECONDS=6.0
FREE_TALK_CORRECTION_MODEL=
# 표현 재사용 판정·후속 질문 같은 잡 보조 호출의 상한. 넘기면 빈 값으로 내려가고 본 응답은 그대로 나간다.
# 본 처리 뒤에 돌므로 BE LANDIT_AI_REQUEST_TIMEOUT(기본 60초)보다 충분히 짧게 둔다.
FREE_TALK_AUXILIARY_TIMEOUT_SECONDS=10.0
# 오프닝·첫 턴에서 후속 질문이 빠졌을 때 한 번 하는 복구 재호출의 상한. 넘기면 첫 응답을 쓴다.
FREE_TALK_FOLLOW_UP_REPAIR_TIMEOUT_SECONDS=8.0
# BE LANDIT_AI_SESSION_FEEDBACK_REQUEST_TIMEOUT보다 짧게 설정한다 (기본 100초 < 120초).
SESSION_LEVEL_ASSESSMENT_BUDGET_SECONDS=100
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
