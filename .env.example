APP_NAME=landit-ai
APP_ENV=local
LOG_LEVEL=INFO
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
MESSAGE_FEEDBACK_MODEL=
OPENROUTER_REVIEW_MODEL=
MESSAGE_FEEDBACK_REVIEW_ENABLED=true
# BE LANDIT_AI_SESSION_FEEDBACK_REQUEST_TIMEOUT보다 짧게 설정한다 (기본 100초 < 120초).
SESSION_LEVEL_ASSESSMENT_BUDGET_SECONDS=100
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
